{
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "./tests",
    "-p",
    "test_*.py",
    "--sw"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/htmlcov/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/htmlcov": true,
    "**/.pytest_cache": true
  }
}
